import java.io.File;

import "https://www.omg.org/spec/SysML/20250201" as sysml
import "http://hu.bme.mit.massif/simulink/1.0" as simulink

// Change propagation: SysML v2 --> Simulink
// Existence rules  : E1, E2, E5, E6, E7, E11, E12
// Property rules   : P1, P3
// Structural rules : S1, S2 (Block <-> SubSystem type migration, folded into
//                    E1/E2 — see SECTION Rule A)
// See README.md §3.4 for the full rule table this maps onto.
// Correspondences are created here; SimulinkToSysML.reactions only looks them up
// (except for its own Rule D cascade, which is Simulink -> SysML only).

// NOTE — segment name must start with lowercase (Reactions DSL requirement)
reactions: sysmlToSimulink
in reaction to changes in sysml
execute actions in simulink

// ============================================================================
// Rule A  —  PartUsage (no children) <-> Block  /  PartUsage (nestedPart) <-> SubSystem
// ============================================================================
//
// NOTE on containment: unlike AMALTHEA's model::Component.components, SysML's
// PartUsage.nestedPart is a DERIVED, transient, volatile feature (computed as
// nestedUsage->selectByKind(PartUsage)). Vitruv cannot listen on insertion into a
// derived feature, so every reaction below listens on unconditional "element created"
// events instead, exactly like the reference project's RunnableCreated /
// VariableLabelCreated reactions did when the logical container differed from the
// real EMF container. The logical parent is found with the single-hop navigation
// affectedEObject.owningRelationship.owningRelatedElement, which are the two REAL
// (non-derived) ends of the generic KerML containment mechanism.

// E1 — PartUsage created -> create a Block with the same name.
//
// Every PartUsage is created childless first (you cannot attach a nestedPart to an
// object that does not exist yet), so this reaction always creates a plain Block —
// never a SubSystem directly. If the new PartUsage is itself being attached under a
// parent PartUsage, attachChildBlock (S1, below) upgrades the PARENT's Block into a
// SubSystem at that point, if this is the parent's first child.
reaction PartUsageCreated {
	after element sysml::PartUsage created
	call createBlockForPartUsage(affectedEObject)
}

routine createBlockForPartUsage(sysml::PartUsage part) {
	match {
		require absence of simulink::Block corresponding to part
		val parentElement = part.owningRelationship.owningRelatedElement
		val parentBlock = retrieve simulink::Block corresponding to parentElement
	}
	create {
		val block = new simulink::Block
		val ref = new simulink::IdentifierReference
	}
	update {
		ref.name = part.declaredName
		block.simulinkRef = ref
		if (parentBlock !== null) {
			attachChildBlock(parentElement, parentBlock, part, block)
		} else {
			persistProjectRelative(part, block, new File("").toString() + "simulink/" + part.declaredName + ".simulink")
		}
		addCorrespondenceBetween(part, block)
	}
}

// S1 — attach a new child Block to its parent's Block, converting the parent from a
// plain Block into a SubSystem first if this is the parent's first child. This is
// the structural counterpart of the reference project's Label.constant flip
// (P8/P9): a condition (child count crossing zero) forces a swap between two
// distinct EClasses, since SubSystem is not a flag on Block but its own EClass.
routine attachChildBlock(sysml::Element parentPart, simulink::Block parentBlock, sysml::PartUsage childPart, simulink::Block child) {
	update {
		if (parentBlock instanceof simulink::SubSystem) {
			(parentBlock as simulink::SubSystem).subBlocks += child
		} else {
			val subSystem = new simulink::SubSystem
			subSystem.simulinkRef = parentBlock.simulinkRef
			// move any pre-existing ports/parameters across before subBlocks is set,
			// so a part that already had interface ports before gaining its first
			// child keeps them.
			val movedPorts = newArrayList
			movedPorts.addAll(parentBlock.ports)
			subSystem.ports += movedPorts
			val movedParams = newArrayList
			movedParams.addAll(parentBlock.parameters)
			subSystem.parameters += movedParams
			subSystem.subBlocks += child
			// re-splice into whatever previously contained parentBlock (another
			// SubSystem's subBlocks, or a root SimulinkModel.contains)
			if (parentBlock.parent !== null) {
				val grandParent = parentBlock.parent
				grandParent.subBlocks -= parentBlock
				grandParent.subBlocks += subSystem
			}
			removeCorrespondenceBetween(parentPart, parentBlock)
			removeObject(parentBlock)
			addCorrespondenceBetween(parentPart, subSystem)
		}
	}
}

// E2 — PartUsage deleted -> delete corresponding Block or SubSystem, then check
// whether this was the parent's LAST child (S2).
reaction PartUsageDeleted {
	after element sysml::PartUsage deleted
	call deleteBlockForPartUsage(affectedEObject)
}

routine deleteBlockForPartUsage(sysml::PartUsage part) {
	match {
		val block = retrieve simulink::Block corresponding to part
		// NOTE: navigating affectedEObject.owningRelationship after a "deleted" event
		// carries the same ordering risk the reference project flagged for P11 — the
		// relationship may already be unlinked by the time this routine runs,
		// depending on exactly when Vitruv fires ElementDeleted relative to EMF's own
		// containment cleanup. Treat parentElement as best-effort, not guaranteed.
		val parentElement = part.owningRelationship?.owningRelatedElement
	}
	update {
		removeObject(block)
		removeCorrespondenceBetween(part, block)
		if (parentElement !== null) {
			downgradeIfChildless(parentElement)
		}
	}
}

// S2 — the parent's corresponding element must revert from SubSystem to a plain
// Block once its last child is removed, mirroring S1's up-conversion.
routine downgradeIfChildless(sysml::Element parentPart) {
	match {
		val parentSubSystem = retrieve simulink::SubSystem corresponding to parentPart
	}
	update {
		if (parentSubSystem !== null && parentSubSystem.subBlocks.empty) {
			val plainBlock = new simulink::Block
			plainBlock.simulinkRef = parentSubSystem.simulinkRef
			val movedPorts = newArrayList
			movedPorts.addAll(parentSubSystem.ports)
			plainBlock.ports += movedPorts
			val movedParams = newArrayList
			movedParams.addAll(parentSubSystem.parameters)
			plainBlock.parameters += movedParams
			if (parentSubSystem.parent !== null) {
				val grandParent = parentSubSystem.parent
				grandParent.subBlocks -= parentSubSystem
				grandParent.subBlocks += plainBlock
			}
			removeCorrespondenceBetween(parentPart, parentSubSystem)
			removeObject(parentSubSystem)
			addCorrespondenceBetween(parentPart, plainBlock)
		}
	}
}

// P1 — PartUsage.declaredName changed -> update Block.simulinkRef.name
reaction PartUsageRenamed {
	after attribute replaced at sysml::PartUsage[declaredName]
	call syncPartUsageNameToBlock(affectedEObject)
}

routine syncPartUsageNameToBlock(sysml::PartUsage part) {
	match {
		val block = retrieve simulink::Block corresponding to part
	}
	update {
		block.simulinkRef.name = part.declaredName
	}
}

// ============================================================================
// Rule B  —  PortUsage <-> InPort / OutPort, disambiguated by direction
// ============================================================================

// E5 — PortUsage (direction = in) created -> create an InPort
reaction InputPortUsageCreated {
	after element sysml::PortUsage created
		with affectedEObject.direction == sysml::FeatureDirectionKind.IN
	call createInPortForPortUsage(affectedEObject)
}

routine createInPortForPortUsage(sysml::PortUsage port) {
	match {
		require absence of simulink::InPort corresponding to port
		val block = retrieve simulink::Block corresponding to port.owningRelationship.owningRelatedElement
	}
	create {
		val inPort = new simulink::InPort
		val ref = new simulink::IdentifierReference
	}
	update {
		ref.name = port.declaredName
		inPort.simulinkRef = ref
		block.ports += inPort
		addCorrespondenceBetween(port, inPort)
	}
}

// E6 — PortUsage (direction = out) created -> create an OutPort
reaction OutputPortUsageCreated {
	after element sysml::PortUsage created
		with affectedEObject.direction == sysml::FeatureDirectionKind.OUT
	call createOutPortForPortUsage(affectedEObject)
}

routine createOutPortForPortUsage(sysml::PortUsage port) {
	match {
		require absence of simulink::OutPort corresponding to port
		val block = retrieve simulink::Block corresponding to port.owningRelationship.owningRelatedElement
	}
	create {
		val outPort = new simulink::OutPort
		val ref = new simulink::IdentifierReference
	}
	update {
		ref.name = port.declaredName
		outPort.simulinkRef = ref
		block.ports += outPort
		addCorrespondenceBetween(port, outPort)
	}
}

// NOTE on direction = inout: intentionally unguarded / unhandled here. Simulink has
// no bidirectional Port EClass, so a PortUsage with direction = inout has no
// corresponding element and no reaction fires for it. See consistency doc, Rule B.

// E7 — PortUsage deleted -> delete corresponding InPort or OutPort
reaction PortUsageDeleted {
	after element sysml::PortUsage deleted
	call deletePortForPortUsage(affectedEObject)
}

routine deleteInPortForPortUsage(sysml::PortUsage port) {
	match {
		val inPort = retrieve simulink::InPort corresponding to port
	}
	update {
		removeObject(inPort)
		removeCorrespondenceBetween(port, inPort)
	}
}

routine deleteOutPortForPortUsage(sysml::PortUsage port) {
	match {
		val outPort = retrieve simulink::OutPort corresponding to port
	}
	update {
		removeObject(outPort)
		removeCorrespondenceBetween(port, outPort)
	}
}

routine deletePortForPortUsage(sysml::PortUsage port) {
	update {
		deleteInPortForPortUsage(port)
		deleteOutPortForPortUsage(port)
	}
}

// P3 — PortUsage.declaredName changed -> update the corresponding Port's simulinkRef.name
reaction PortUsageRenamed {
	after attribute replaced at sysml::PortUsage[declaredName]
	call syncPortUsageName(affectedEObject)
}

routine syncInPortName(sysml::PortUsage port) {
	match {
		val inPort = retrieve simulink::InPort corresponding to port
	}
	update {
		inPort.simulinkRef.name = port.declaredName
	}
}

routine syncOutPortName(sysml::PortUsage port) {
	match {
		val outPort = retrieve simulink::OutPort corresponding to port
	}
	update {
		outPort.simulinkRef.name = port.declaredName
	}
}

routine syncPortUsageName(sysml::PortUsage port) {
	update {
		syncInPortName(port)
		syncOutPortName(port)
	}
}

// ============================================================================
// Rule C  —  FlowUsage <-> SingleConnection
// ============================================================================

// E11 — 2-ended FlowUsage created -> create a SingleConnection between the
// corresponding OutPort and InPort
reaction FlowUsageCreated {
	after element sysml::FlowUsage created
		with affectedEObject.flowEnd.size == 2
	call createConnectionForFlowUsage(affectedEObject)
}

routine createConnectionForFlowUsage(sysml::FlowUsage flow) {
	match {
		require absence of simulink::SingleConnection corresponding to flow
		// flowEnd.get(0) is expected to be typed by an `out` PortUsage, flowEnd.get(1)
		// by an `in` PortUsage — see Rule C in the consistency doc.
		val outPort = retrieve simulink::OutPort corresponding to flow.flowEnd.get(0)
		val inPort = retrieve simulink::InPort corresponding to flow.flowEnd.get(1)
	}
	create {
		val connection = new simulink::SingleConnection
	}
	update {
		connection.from = outPort
		connection.to = inPort
		addCorrespondenceBetween(flow, connection)
	}
}

// E12 — FlowUsage deleted -> delete corresponding SingleConnection
reaction FlowUsageDeleted {
	after element sysml::FlowUsage deleted
	call deleteConnectionForFlowUsage(affectedEObject)
}

routine deleteConnectionForFlowUsage(sysml::FlowUsage flow) {
	match {
		val connection = retrieve simulink::SingleConnection corresponding to flow
	}
	update {
		removeObject(connection)
		removeCorrespondenceBetween(flow, connection)
	}
}

// NOTE: MultiConnection has no FlowUsage equivalent here — see consistency doc, Rule C.
